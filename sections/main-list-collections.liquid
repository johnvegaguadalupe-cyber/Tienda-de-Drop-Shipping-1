<div class="section main-list-collections page-width">
  <h1>{{ section.settings.heading }}</h1>
  <div class="collection-grid" style="--columns: {{ section.settings.columns }};">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="collection-card">
        <div class="collection-card__media">
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" loading="lazy" width="600" height="400">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <h2 class="collection-card__title">{{ collection.title }}</h2>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Listado de colecciones",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Todas las colecciones" },
    { "type": "range", "id": "columns", "label": "Columnas en escritorio", "min": 2, "max": 5, "step": 1, "default": 3 }
  ]
}
{% endschema %}
