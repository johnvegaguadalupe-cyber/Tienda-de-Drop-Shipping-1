<div class="section rich-text page-width rich-text--{{ section.settings.alignment }}">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.content != blank -%}
    <div class="rich-text__content">{{ section.settings.content }}</div>
  {%- endif -%}
  {%- if section.settings.button_label != blank -%}
    <a href="{{ section.settings.button_link }}" class="button button--secondary">{{ section.settings.button_label }}</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Texto libre",
  "settings": [
    { "type": "select", "id": "alignment", "label": "Alineación", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "center" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Sobre nosotros" },
    { "type": "richtext", "id": "content", "label": "Contenido", "default": "<p>Cuenta la historia de tu marca y qué hace especiales a tus productos.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [
    { "name": "Texto libre" }
  ]
}
{% endschema %}
