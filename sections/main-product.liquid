{%- liquid
  assign product = product
  assign current_variant = product.selected_or_first_available_variant
-%}
<div class="section main-product page-width">
  <div class="main-product__gallery" data-product-gallery>
    {%- if product.media.size > 0 -%}
      <div class="main-product__main-image">
        <img
          src="{{ current_variant.featured_media.preview_image | default: product.featured_media.preview_image | image_url: width: 900 }}"
          alt="{{ product.featured_media.alt | escape }}"
          id="MainProductImage"
          width="900"
          height="900"
        >
      </div>
      {%- if product.media.size > 1 -%}
        <div class="main-product__thumbs">
          {%- for media in product.media -%}
            <button type="button" class="main-product__thumb{% if forloop.first %} is-active{% endif %}" data-thumb data-full-src="{{ media | image_url: width: 900 }}">
              <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}" loading="lazy" width="80" height="80">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="main-product__main-image">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    {%- endif -%}
  </div>

  <div class="main-product__info">
    {%- if product.vendor != blank -%}
      <p class="main-product__vendor">{{ product.vendor }}</p>
    {%- endif -%}
    <h1 class="main-product__title">{{ product.title }}</h1>

    {% render 'price', product: product, variant: current_variant %}

    {%- if section.settings.show_countdown -%}
      <div class="urgency-banner" data-countdown data-countdown-minutes="{{ section.settings.countdown_minutes }}">
        <span>{{ section.settings.countdown_text }}</span>
        <span class="urgency-banner__timer" data-countdown-timer>--:--:--</span>
      </div>
    {%- endif -%}

    <div class="main-product__description">{{ product.description }}</div>

    {% form 'product', product, id: 'MainProductForm', class: 'main-product__form' %}
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="main-product__option">
            <label for="Option-{{ option.position }}">{{ option.name }}</label>
            <select name="options[{{ option.name | escape }}]" id="Option-{{ option.position }}" data-option-selector>
              {%- for value in option.values -%}
                <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <select name="id" data-variant-id-select hidden>
        {%- for variant in product.variants -%}
          <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %} data-option-values="{{ variant.options | join: ',' | escape }}">
            {{ variant.title }}
          </option>
        {%- endfor -%}
      </select>

      <div class="main-product__quantity">
        <label for="Quantity">{{ 'products.product.quantity' | t }}</label>
        <input type="number" name="quantity" id="Quantity" value="1" min="1">
      </div>

      <button type="submit" class="button button--primary button--large" data-add-to-cart{% unless current_variant.available %} disabled{% endunless %}>
        <span data-add-to-cart-text>
          {%- if current_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
      </button>
    {% endform %}

    {%- if section.settings.show_trust_row -%}
      <ul class="main-product__trust-row">
        <li>{% render 'icon', icon: 'truck', size: 18 %} {{ section.settings.trust_shipping_text }}</li>
        <li>{% render 'icon', icon: 'shield', size: 18 %} {{ section.settings.trust_payment_text }}</li>
        <li>{% render 'icon', icon: 'refresh', size: 18 %} {{ section.settings.trust_returns_text }}</li>
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Página de producto",
  "settings": [
    { "type": "checkbox", "id": "show_countdown", "label": "Mostrar contador de urgencia", "default": true },
    { "type": "text", "id": "countdown_text", "label": "Texto del contador", "default": "¡Oferta termina en:" },
    { "type": "range", "id": "countdown_minutes", "label": "Minutos del contador", "min": 15, "max": 1440, "step": 15, "default": 60 },
    { "type": "checkbox", "id": "show_trust_row", "label": "Mostrar franja de confianza", "default": true },
    { "type": "text", "id": "trust_shipping_text", "label": "Texto envío", "default": "Envío en 3-7 días" },
    { "type": "text", "id": "trust_payment_text", "label": "Texto pago", "default": "Pago 100% seguro" },
    { "type": "text", "id": "trust_returns_text", "label": "Texto devoluciones", "default": "30 días de devolución" }
  ]
}
{% endschema %}
