<div class="section faq page-width">
  <h2 class="section__header">{{ section.settings.heading }}</h2>

  <div class="faq__list">
    {%- for block in section.blocks -%}
      <div class="faq__item">
        <button type="button" class="faq__question" data-faq-toggle aria-expanded="false">
          <span>{{ block.settings.question }}</span>
          {% render 'icon', icon: 'chevron-down' %}
        </button>
        <div class="faq__answer" hidden>
          <p>{{ block.settings.answer }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Preguntas frecuentes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Cuánto tarda el envío?" },
        { "type": "textarea", "id": "answer", "label": "Respuesta", "default": "El envío estándar tarda entre 5 y 10 días laborables." }
      ]
    }
  ]
}
{% endschema %}
