<div class="section trust-badges page-width">
  <ul class="trust-badges__list">
    {%- for block in section.blocks -%}
      <li class="trust-badges__item" {{ block.shopify_attributes }}>
        {% render 'icon', icon: block.settings.icon, size: 32 %}
        <div>
          <p class="trust-badges__title">{{ block.settings.title }}</p>
          <p class="trust-badges__text">{{ block.settings.text }}</p>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Iconos de confianza",
  "blocks": [
    {
      "type": "badge",
      "name": "Icono",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "truck", "label": "Camión (envío)" },
            { "value": "shield", "label": "Escudo (pago seguro)" },
            { "value": "refresh", "label": "Flechas (devoluciones)" },
            { "value": "star", "label": "Estrella (calidad)" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Envío rápido" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Entrega en 3-7 días" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "badge", "settings": { "icon": "truck", "title": "Envío rápido", "text": "Entrega en 3-7 días" } },
      { "type": "badge", "settings": { "icon": "shield", "title": "Pago 100% seguro", "text": "Cifrado SSL" } },
      { "type": "badge", "settings": { "icon": "refresh", "title": "Devolución fácil", "text": "30 días para cambios" } },
      { "type": "badge", "settings": { "icon": "star", "title": "Calidad garantizada", "text": "Productos revisados" } }
    ]
  },
  "presets": [
    {
      "name": "Iconos de confianza",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "title": "Envío rápido", "text": "Entrega en 3-7 días" } },
        { "type": "badge", "settings": { "icon": "shield", "title": "Pago 100% seguro", "text": "Cifrado SSL" } },
        { "type": "badge", "settings": { "icon": "refresh", "title": "Devolución fácil", "text": "30 días para cambios" } },
        { "type": "badge", "settings": { "icon": "star", "title": "Calidad garantizada", "text": "Productos revisados" } }
      ]
    }
  ]
}
{% endschema %}
