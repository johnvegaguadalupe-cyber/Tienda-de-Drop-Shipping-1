<div class="section trust-badges page-width">
  <ul class="trust-badges__list">
    {%- for block in section.blocks -%}
      <li class="trust-badges__item">
        <p class="trust-badges__title">{{ block.settings.title }}</p>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Iconos de confianza",
  "blocks": [
    {
      "type": "shipping",
      "name": "Envío",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Envío rápido" }
      ]
    }
  ]
}
{% endschema %}
