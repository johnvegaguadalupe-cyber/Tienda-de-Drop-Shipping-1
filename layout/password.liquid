<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  {% style %}
    :root {
      --color-background: {{ settings.color_background }};
      --color-text: {{ settings.color_text }};
      --color-primary: {{ settings.color_primary }};
      --color-primary-text: {{ settings.color_primary_text }};
      --color-primary-end: {{ settings.color_primary_end | default: settings.color_primary }};
      --color-border: {{ settings.color_border }};
      --color-text-muted: color-mix(in srgb, {{ settings.color_text }} 65%, {{ settings.color_background }} 35%);
      --border-radius: {{ settings.border_radius }}px;
      --font-heading-family: {{ settings.font_heading.family | default: 'sans-serif' }}, sans-serif;
      --font-body-family: {{ settings.font_body.family | default: 'sans-serif' }}, sans-serif;
    }
  {% endstyle %}
  {%- if settings.font_heading.family -%}
    {{ settings.font_heading | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if settings.font_body.family -%}
    {{ settings.font_body | font_face: font_display: 'swap' }}
  {%- endif -%}
  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
</head>
<body class="template-password">
  <main class="password-page">
    <div class="password-page__box">
      {% if settings.favicon %}
        <img src="{{ settings.favicon | image_url: width: 64 }}" alt="{{ shop.name }}" width="64" height="64">
      {% endif %}
      <h1>{{ shop.name }}</h1>

      {% if shop.password_message != blank %}
        <div class="password-page__message">{{ shop.password_message }}</div>
      {% endif %}

      {% form 'storefront_password' %}
        {% if form.errors %}
          <p class="form-error">{{ 'general.password_page.login_form_error' | t }}</p>
        {% endif %}
        <label for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
        <input type="password" name="password" id="Password" required>
        <button type="submit" class="button button--primary">
          {{ 'general.password_page.login_password_button' | t }}
        </button>
      {% endform %}

      <p class="password-page__admin-link">{{ 'general.password_page.admin_link_html' | t }}</p>
    </div>
  </main>
</body>
</html>
